<%= turbo_frame_tag "modal", class: "overflow-hidden print:hidden" do %>
  <%= tag.div class: "relative z-30", role: "dialog",
              aria: { labelledby: "modal-title", modal: true },
              data: { controller: "turbo-modal",
                      action: token_list("turbo:submit-end->turbo-modal#submitEnd", "keyup@window->turbo-modal#closeWithKeyboard") } do %>
    <!--
      Background backdrop, show/hide based on modal state.
      Entering: "ease-out duration-300"
      From: "opacity-0"
      To: "opacity-100"
      Leaving: "ease-in duration-200"
      From: "opacity-100"
      To: "opacity-0"
    -->
    <%= tag.div class: "fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity hidden",
                data: { turbo_modal_target: 'backdrop',
                        transition_enter: "ease-out duration-300",
                        transition_enter_start: "opacity-0",
                        transition_enter_end: "opacity-100",
                        transition_leave: "ease-in duration-200",
                        transition_leave_start: "opacity-100",
                        transition_leave_end: "opacity-0" } %>
    <%= tag.div class: "fixed inset-0 z-40 overflow-y-auto" do %>
      <%= tag.div class: "flex min-h-full items-stretch justify-center text-center sm:items-center" do %>
        <!--
          Modal panel, show/hide based on modal state.
          Entering: "ease-out duration-300"
          From: "opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
          To: "opacity-100 translate-y-0 sm:scale-100"
          Leaving: "ease-in duration-200"
          From: "opacity-100 translate-y-0 sm:scale-100"
          To: "opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
        -->
        <%= tag.div class: "divide-y relative transform sm:rounded-lg bg-white text-left shadow-xl transition-all m-0 sm:m-6 w-full #{modal_size_class} hidden",
                    data: { turbo_modal_target: 'modal',
                            transition_enter: "ease-out duration-300",
                            transition_enter_start: "opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95",
                            transition_enter_end: "opacity-100 translate-y-0 sm:scale-100",
                            transition_leave: "ease-in duration-200",
                            transition_leave_start: "opacity-100 translate-y-0 sm:scale-100",
                            transition_leave_end: "opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" } do %>
          <!-- HEADER -->
          <%= tag.div class: "flex items-center space-x-3 p-3 print:hidden" do %>
            <%= tag.div class: "block flex-1 truncate" do %>
              <h5>
                <%= @title %>
              </h5>
            <% end %>
            <%#= tag.div class: "block flex-shrink-0" do %>
              <%# if @options.fetch(:printable, false) %>
                <%#= link_to print_modal_index_path(params: { body: content }), target: "_blank", class: 'btn-circle' do %>
                  <%#= heroicon 'printer', options: { class: 'btn-circle__icon' } %>
                <%# end %>
              <%# end %>
            <%# end %>
            <%= tag.div class: "block flex-shrink-0" do %>
              <%= button_tag id: 'close_modal', data: { action: "turbo-modal#hideModal" }, type: "button", class: 'btn-circle' do %>
                <%= heroicon 'x-mark', options: { class: 'btn-circle__icon' } %>
              <% end %>
            <% end %>
          <% end %>


          <!-- BODY -->
          <% if bodies.present? %>
            <% bodies.each do |body| %>
              <%= tag.div id: 'modal_body', class: "block sm:p-3 " do %>
                <%= body %>
              <% end %>
            <% end %>
          <% end %>

          <% if content.present? %>
            <%= tag.div class: "block sm:pb-3" do %>
              <%= content %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>