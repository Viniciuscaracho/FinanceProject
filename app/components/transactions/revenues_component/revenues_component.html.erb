<%= turbo_frame_tag :revenues, class: 'h-full' do %>
  <% if @show_value %>
    <div class="block w-full h-full">
      <div class="block text-gray-500">
        <%= t('components.transactions.revenues.title') %>
      </div>
      <div class="grid grid-cols-3 w-full">
        <div class="col-span-3 flex items-center space-x-2">
          <div class="flex-1 h-2 bg-gray-200 rounded-full overflow-hidden relative">
            <div class="absolute flex items-center h-2 bg-success-500 overflow-visible" style="width: <%= number_to_percentage(@percentage, precision: 0) %>"></div>
          </div>
          <span class="flex-shrink-0 text-success-500 font-medium text-xs" data-hide-amount-target='amountField' >
            <%= number_to_percentage(@percentage, precision: 2) %>
          </span>
        </div>
        <div class="truncate text-xs text-success-500" >
          <%= t('components.transactions.revenues.paid') %>
        </div>
        <div class="col-span-2 text-xs font-medium text-success-500 text-right" data-hide-amount-target='amountField' >
          <%= @paid_amount %>
        </div>
        <div class="truncate text-xs text-gray-500">
          <%= t('components.transactions.revenues.predicted') %>
        </div>
        <div class="col-span-2 text-xs font-medium text-gray-500 text-right" data-hide-amount-target='amountField' >
          <%= @predicted_amount %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="block w-full h-full">
      <div class="block text-gray-500">
        <%= t('components.transactions.revenues.title') %>
      </div>
      <div class="grid grid-cols-3 w-full">
        <div class="col-span-3 flex items-center space-x-2">
          <div class="flex-1 h-2 bg-gray-200 rounded-full overflow-hidden relative">
            <div class="absolute flex items-center h-2 bg-success-500 overflow-visible"></div>
          </div>
          <span class="flex-shrink-0 text-success-500 font-medium text-xs">
            <%= t("shared.percentage_placeholder") %>
          </span>
        </div>
        <div class="truncate text-xs text-success-500">
          <%= t('components.transactions.revenues.paid') %>
        </div>
        <div class="col-span-2 text-xs font-medium text-success-500 text-right ">
          <%= t("shared.currency_placeholder") %>
        </div>
        <div class="truncate text-xs text-gray-500">
          <%= t('components.transactions.revenues.predicted') %>
        </div>
        <div class="col-span-2 text-xs font-medium text-gray-500 text-right">
          <%= t("shared.currency_placeholder") %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
