<%= turbo_frame_tag :expenses, class: 'h-full' do %>
  <% if @show_value %>
    <div class="block w-full">
      <div class="block text-gray-500 justify-between">
        <div class="flex items-center">
          <%= I18n.t('components.transactions.expenses.title') %>
          <%= render(Info::PlusComponent.new(options: { class: "ml-1" }, url: details_expenses_transactions_url(params: { bank_account_id: @bank_account_id , month: @month }))) %>
        </div>
      </div>
      <div class="grid grid-cols-3 w-full">
        <div class="col-span-3 flex items-center space-x-2">
          <div class="flex-1 h-2 bg-gray-200 rounded-full overflow-hidden relative">
            <div class="absolute flex items-center h-2 bg-danger-500 overflow-visible" style="width: <%= number_to_percentage(@percentage, precision: 0) %>"></div>
          </div>
          <span class="flex-shrink-0 text-danger-500 font-medium text-xs" data-hide-amount-target='amountField' >
            <%= number_to_percentage(@percentage, precision: 2) %>
          </span>
        </div>
        <div class="truncate text-xs text-danger-500">
          <%= I18n.t('components.transactions.expenses.paid_expenses') %>
        </div>
        <div class="col-span-2 text-xs font-medium text-danger-500 text-right" data-hide-amount-target='amountField' >
          <%= @paid_amount %>
        </div>
        <div class="truncate text-xs text-gray-500">
          <%= I18n.t('components.transactions.expenses.prev_expenses') %>
        </div>
        <div class="col-span-2 text-xs font-medium text-gray-500 text-right" data-hide-amount-target='amountField' >
          <%= @predicted_amount %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="block w-full">
      <div class="block text-gray-500 justify-between">
        <div class="flex items-center">
          <%= I18n.t('components.transactions.expenses.title') %>
        </div>
      </div>
      <div class="grid grid-cols-3 w-full">
        <div class="col-span-3 flex items-center space-x-2">
          <div class="flex-1 h-2 bg-gray-200 rounded-full overflow-hidden relative">
            <div class="absolute flex items-center h-2 bg-danger-500 overflow-visible"></div>
          </div>
          <span class="flex-shrink-0 text-danger-500 font-medium text-xs">
            <%= t("shared.percentage_placeholder") %>
          </span>
        </div>
        <div class="truncate text-xs text-danger-500">
          <%= I18n.t('components.transactions.expenses.paid_expenses') %>
        </div>
        <div class="col-span-2 text-xs font-medium text-danger-500 text-right">
          <%= t("shared.currency_placeholder") %>
        </div>
        <div class="truncate text-xs text-gray-500">
          <%= I18n.t('components.transactions.expenses.prev_expenses') %>
        </div>
        <div class="col-span-2 text-xs font-medium text-gray-500 text-right">
          <%= t("shared.currency_placeholder") %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
