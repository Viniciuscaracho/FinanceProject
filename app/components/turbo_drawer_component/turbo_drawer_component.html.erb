<%= turbo_frame_tag "drawer" do %>
  <%= tag.div data: { controller: "turbo-drawer", action: token_list(@close_on_submit ? "turbo:submit-end->turbo-drawer#submitEnd" : nil, "keyup@window->turbo-drawer#closeWithKeyboard", "mousedown@window->turbo-drawer#closeBackground") }, class: "relative z-auto" do %>
    <%= tag.div class: "z-50 pointer-events-none fixed inset-y-0 right-0 flex #{@options.fetch(:max_w, 'max-w-md')} sm:max-w-full sm:pl-10" do %>
      <%= tag.div class: "pointer-events-auto w-screen #{@options.fetch(:max_w, 'max-w-md')} hidden",
                  data: { turbo_drawer_target: :drawer,
                          transition_enter: "transition ease-in-out duration-200 transform",
                          transition_enter_start: "translate-x-full",
                          transition_enter_end: "translate-x-0",
                          transition_leave: "transition ease-in-out duration-100 transform",
                          transition_leave_start: "translate-x-0",
                          transition_leave_end: "translate-x-full" } do %>
        <%= tag.div class: 'flex h-full flex-col bg-white shadow-xl overflow-auto' do %>
          <%= tag.div class: 'py-6 px-3 sm:px-6 sticky top-0 bg-white z-50' do %>
            <%= tag.div class: 'flex items-start justify-between' do %>
              <%= tag.div class: 'block' do %>
                <%= tag.div class: 'text-lg font-medium text-gray-900' do %>
                  <%= @title %>
                <% end %>
                <% if @subtitle.present? %>
                  <%= tag.div class: 'text-sm text-gray-400' do %>
                    <%= @subtitle %>
                  <% end %>
                <% end %>
              <% end %>
              <%= tag.div class: 'ml-3 flex h-8 items-center' do %>
                <%= button_tag data: { action: "turbo-drawer#hideDrawer" }, type: "button",  class: 'btn-circle', id: 'close_drawer' do %>
                  <%= heroicon 'x-mark', options: { class: 'btn-circle__icon'} %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
          <%= tag.div class: 'flex-1 mb-6' do %>
            <%= tag.div class: 'px-3 sm:px-6' do %>
              <%= content %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
