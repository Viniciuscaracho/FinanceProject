# Supabase Configuration
# Copie este arquivo para .env e preencha com suas credenciais reais
# NUNCA commite o arquivo .env no Git!

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic / Claude AI (estruturação de notas de coaching)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI Whisper (transcrição de áudio — Fatia B coaching)
# OPENAI_API_KEY=sk-...

# Nota: Para funcionalidades completas do backend, você também precisará de:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# SUPABASE_JWT_SECRET=your-jwt-secret-here

# Para obter essas credenciais:
# 1. Acesse https://supabase.com/dashboard
# 2. Selecione seu projeto
# 3. Vá em Settings > API
# 4. Copie as credenciais necessárias

# WhatsApp — Bot central da plataforma (fallback quando o profissional não tem bot próprio)
# Se configurado, mensagens automáticas são enviadas por este número quando a conta não tem
# Evolution API própria habilitada.
# PLATFORM_WA_API_URL=https://evolution.sua-plataforma.com
# PLATFORM_WA_API_KEY=sua-api-key-aqui
# PLATFORM_WA_INSTANCE=orbi-platform

# Meta Marketing API — anúncios de tráfego pago da Orbi
# META_ADS_ACCESS_TOKEN: token de System User de longa duração (gerado em
#   Business Manager → System Users → gerar token com ads_management + ads_read).
# META_ADS_ACCOUNT_ID: ID da conta de anúncios no formato act_XXXXXXXXXX.
# META_FB_PAGE_ID: ID da Página do Facebook da Orbi (necessário para criativo de link).
# META_ADS_ACCESS_TOKEN=EAAxxxxxx...
# META_ADS_ACCOUNT_ID=act_0000000000
# META_FB_PAGE_ID=000000000000

# WhatsApp Cloud API oficial (Meta) — inbound webhook
# WHATSAPP_VERIFY_TOKEN: string que VOCÊ escolhe; precisa ser idêntica ao campo
#   "Verificar token" no painel da Meta (usada no handshake GET do webhook).
# WHATSAPP_APP_SECRET: App Secret do app (Meta → App settings → Basic); valida a
#   assinatura X-Hub-Signature-256 das mensagens recebidas (POST).
# WHATSAPP_VERIFY_TOKEN=troque-por-um-token-secreto
# WHATSAPP_APP_SECRET=app-secret-do-painel-meta

# Modo enxuto de coaching (produção)
# Quando "true", a API responde APENAS aos controllers do fluxo de coaching
# (auth, coaching/*, whatsapp webhook/config/messages, contacts, users,
# account_settings, public). Todo o restante da plataforma retorna 403.
# Reverter = apagar/definir como "false". Nada é removido do código.
# Combine com VITE_COACHING_ONLY=true no build do frontend.
# COACHING_ONLY_MODE=true

# Proxy reverso / Cloudflare Tunnel
# A aplicação roda atrás de um Cloudflare Tunnel (e, em alguns deploys, de um
# proxy extra tipo Traefik/EasyPanel). Por padrão o Rails passa a confiar na
# cadeia de proxy (desliga o ip_spoofing_check e adiciona as faixas da
# Cloudflare como trusted_proxies) para não retornar 500 (IpSpoofAttackError)
# em toda requisição por causa dos cabeçalhos X-Forwarded-For empilhados.
# TRUST_PROXY_HEADERS=false  # volta ao comportamento padrão do Rails
# TRUSTED_PROXIES=10.0.0.5,203.0.113.7  # IPs/CIDRs extras de proxies internos
