# Supabase Configuration
# Copie este arquivo para .env e preencha com suas credenciais reais
# NUNCA commite o arquivo .env no Git!

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic / Claude AI
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Nota: Para funcionalidades completas do backend, você também precisará de:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# SUPABASE_JWT_SECRET=your-jwt-secret-here

# Para obter essas credenciais:
# 1. Acesse https://supabase.com/dashboard
# 2. Selecione seu projeto
# 3. Vá em Settings > API
# 4. Copie as credenciais necessárias

# WhatsApp — Bot central da plataforma (fallback quando o profissional não tem bot próprio)
# Se configurado, mensagens automáticas são enviadas por este número quando a conta não tem
# Evolution API própria habilitada.
# PLATFORM_WA_API_URL=https://evolution.sua-plataforma.com
# PLATFORM_WA_API_KEY=sua-api-key-aqui
# PLATFORM_WA_INSTANCE=orbi-platform
