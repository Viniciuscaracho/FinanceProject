{
  "name": "barber-management-performance-tests",
  "version": "1.0.0",
  "description": "Testes de performance e E2E para o sistema de gerenciamento de barbearia",
  "scripts": {
    "test": "playwright test",
    "test:performance": "playwright test --project=performance",
    "test:e2e": "playwright test --grep-invert performance",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:ux-audit": "playwright test --project=ux-audit --headed",
    "test:ux-audit:ci": "playwright test --project=ux-audit",
    "seed:meal-plans": "cd ../.. && rails runner db/seeds/meal_plans_data.rb",
    "report": "playwright show-report",
    "lighthouse": "lhci autorun"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@lhci/cli": "^0.12.0"
  }
}

