#!/usr/bin/env ruby
# frozen_string_literal: true
#
# Lê GOOGLE_CLIENT_ID e GOOGLE_CLIENT_SECRET do .env e grava nas
# credentials criptografadas do ambiente Rails atual.
#
# Uso:
#   RAILS_ENV=staging bundle exec ruby bin/fix_google_credentials
#
# Não expõe valores no histórico de shell — lê direto do arquivo.

require_relative '../config/environment'

env_file = File.expand_path('../../.env', __FILE__)
abort "❌  .env não encontrado em #{env_file}" unless File.exist?(env_file)

env_vars = File.readlines(env_file, chomp: true).each_with_object({}) do |line, h|
  next if line.start_with?('#') || line.strip.empty?
  k, v = line.split('=', 2)
  h[k] = v if k && v
end

client_id     = env_vars['GOOGLE_CLIENT_ID']
client_secret = env_vars['GOOGLE_CLIENT_SECRET']

abort "❌  GOOGLE_CLIENT_ID não encontrado no .env"     if client_id.to_s.strip.empty?
abort "❌  GOOGLE_CLIENT_SECRET não encontrado no .env" if client_secret.to_s.strip.empty?

current_yaml = Rails.application.credentials.read
config = YAML.safe_load(current_yaml, permitted_classes: [Symbol]) || {}
config['google'] = { 'client_id' => client_id.strip, 'client_secret' => client_secret.strip }

Rails.application.credentials.write(config.to_yaml)
puts "✅  google.client_id e google.client_secret gravados nas credentials de #{Rails.env}"
puts "    Faça commit do staging.yml.enc e push para stage."
