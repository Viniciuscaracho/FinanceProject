# Anthropic credentials. The SDK also picks up an `ant auth login` profile
# automatically, so this is only needed when you want an explicit key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default model (defaults to claude-opus-4-8).
ORBI_MODEL=claude-opus-4-8

# Optional: reasoning effort for agents (low | medium | high | xhigh | max).
ORBI_EFFORT=high
