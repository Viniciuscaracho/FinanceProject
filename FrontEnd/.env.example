# Supabase Configuration
# Copie este arquivo para .env e preencha com suas credenciais reais
# NUNCA commite o arquivo .env no Git!

# Variáveis com prefixo VITE_ são expostas no frontend
# Use apenas chaves públicas (anon key), nunca service_role_key!

VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Para obter essas credenciais:
# 1. Acesse https://supabase.com/dashboard
# 2. Selecione seu projeto
# 3. Vá em Settings > API
# 4. Copie a Project URL e anon public key
