# Supabase Configuration
# Copie este arquivo para .env e preencha com suas credenciais reais
# NUNCA commite o arquivo .env no Git!

# Variáveis com prefixo VITE_ são expostas no frontend
# Use apenas chaves públicas (anon key), nunca service_role_key!

VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Modo enxuto de coaching (produção)
# Quando "true", a interface expõe apenas o fluxo de coaching (análise, atletas e
# a conexão do WhatsApp em /settings); o restante do menu e das rotas fica oculto
# e redireciona para /coaching. Reverter = "false" e rebuildar.
# Combine com COACHING_ONLY_MODE=true no backend.
# VITE_COACHING_ONLY=true

# Para obter essas credenciais:
# 1. Acesse https://supabase.com/dashboard
# 2. Selecione seu projeto
# 3. Vá em Settings > API
# 4. Copie a Project URL e anon public key
